{
  "uid": "qbank-follow-request",
  "title": "Question Bank: follow one request",
  "description": "Find everything that happened for one request ID, or one coaching.",
  "tags": [
    "qbank"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "description": "The X-Request-ID shown with an error (starts with req_ or web_).",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "organization_id",
        "label": "Coaching (organization id)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 26,
      "type": "logs",
      "title": "Every log line of this request (API, web, worker)",
      "description": "Paste a request ID above. Click a line, then 'Open trace' for the full trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"qbank-.+\"} |= \"$request_id\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 27,
      "type": "table",
      "title": "Traces of this request",
      "description": "Click a trace ID to open it. Spans of the request, its SQL and the job it queued.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ span.request.id = \"$request_id\" }",
          "limit": 20,
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 28,
      "type": "logs",
      "title": "Recent errors of one coaching",
      "description": "Type a coaching id above. Logs keep an organization_id on every line of a signed-in request.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"qbank-.+\"} | json | organization_id=\"$organization_id\" | level=~\"error|warning\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
