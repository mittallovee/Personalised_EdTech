# Copy to .env.offsite in the repository root and fill in (docs/operations/offsite-backups.md).
# .env.offsite is ignored by Git. Never commit it, and never paste these values into chat or a ticket.

# The encrypted backup store: your Cloudflare R2 bucket. Find the account id on the R2 overview page.
RESTIC_REPOSITORY=s3:https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/YOUR_BUCKET_NAME

# The password that encrypts every backup. Make it long and random, and keep a copy in your password
# manager. Without it NOTHING can be restored, not even by you.
RESTIC_PASSWORD=

# An R2 API token with "Object Read & Write", limited to this one bucket (Access Key ID / Secret Access Key).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: a healthchecks.io (or similar) ping address. It emails you when a day passes with no
# successful backup, which is how you find out the PC was off or the backup broke.
HEALTHCHECK_URL=

# Optional: the Docker volume with the uploaded pictures, when more than one volume's name ends in
# "assetdata". Leave empty to find it automatically.
ASSET_VOLUME=
