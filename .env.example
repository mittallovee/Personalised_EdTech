# Copy to .env and adjust. Never commit .env.
# Every variable the app reads is listed here with a safe local example.

# --- Application ---
APP_ENV=local            # local | test | staging | production
LOG_LEVEL=INFO
SESSION_COOKIE_SECURE=false   # true everywhere except plain-http local development
# Web addresses allowed to send changes to the API from a browser (JSON list; https when hosted).
ALLOWED_ORIGINS='["http://localhost:3000"]'
# Behind Cloudflare (docs/operations/remote-access.md): the header with the visitor's real IP.
# Leave empty when the app is only used on this PC.
CLIENT_IP_HEADER=
# Sign-in and link attempts allowed per address / per email in 5 minutes (defaults 20 / 10).
# Raise them only for the browser tests, which make all their requests from one address.
# LOGIN_ATTEMPTS_PER_IP=20
# LOGIN_ATTEMPTS_PER_EMAIL=10
# Syllabus import (ADR-0018): files one person may upload in 10 minutes, and files read at once.
# Defaults 10 / 600 s / 2. Raise the first only for the browser tests.
# IMPORT_UPLOADS_PER_USER=10
# IMPORT_UPLOAD_WINDOW_SECONDS=600
# IMPORT_PARSES_AT_ONCE=2

# Sign in with Google (B-02). Off while both are empty. Get them from the one-time Google Cloud
# setup in docs/operations/google-login.md. The secret is a password: never commit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitoring (ADR-0019): Grafana, Prometheus, Loki and Tempo. Off by default. To turn it on, remove
# the leading # from the first two lines, set a password, then `docker compose up -d`.
# Grafana opens at http://localhost:3001 (user admin).
# COMPOSE_PROFILES=observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# GRAFANA_ADMIN_PASSWORD=choose-your-own-password

# --- PostgreSQL (local Docker) ---
# Table owner: creates the database and runs migrations.
POSTGRES_USER=qbank_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=qbank_dev
# Restricted runtime roles used by the API and the background worker (cannot bypass row-level
# security, see ADR-0005). The db-init service creates them, or updates their passwords, on every
# `docker compose up`.
# Use only letters/digits in local passwords: they are placed inside connection URLs.
APP_DB_PASSWORD=change-me-app-local
WORKER_DB_PASSWORD=change-me-worker-local

# --- Integration tests (make backend-check) ---
# A disposable server is enough; tests create and drop their own database.
QBANK_TEST_ADMIN_URL=postgresql+psycopg://qbank_owner:change-me-local-only@localhost:5432/postgres
QBANK_TEST_APP_PASSWORD=change-me-app-local
QBANK_TEST_WORKER_PASSWORD=change-me-worker-local
