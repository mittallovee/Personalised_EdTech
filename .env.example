# Copy to .env and adjust. Never commit .env.
# Every variable the app reads is listed here with a safe local example.

# --- Application ---
APP_ENV=local            # local | test | staging | production
LOG_LEVEL=INFO
SESSION_COOKIE_SECURE=false   # true everywhere except plain-http local development
# Web addresses allowed to send changes to the API from a browser (JSON list; https when hosted).
ALLOWED_ORIGINS='["http://localhost:3000"]'

# --- PostgreSQL (local Docker) ---
# Table owner: creates the database and runs migrations.
POSTGRES_USER=qbank_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=qbank_dev
# Restricted runtime roles used by the API and the background worker (cannot bypass row-level
# security, see ADR-0005). The db-init service creates them, or updates their passwords, on every
# `docker compose up`.
# Use only letters/digits in local passwords: they are placed inside connection URLs.
APP_DB_PASSWORD=change-me-app-local
WORKER_DB_PASSWORD=change-me-worker-local

# --- Integration tests (make backend-check) ---
# A disposable server is enough; tests create and drop their own database.
QBANK_TEST_ADMIN_URL=postgresql+psycopg://qbank_owner:change-me-local-only@localhost:5432/postgres
QBANK_TEST_APP_PASSWORD=change-me-app-local
QBANK_TEST_WORKER_PASSWORD=change-me-worker-local
